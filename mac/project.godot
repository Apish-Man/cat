config_version=5

[application]
config/name="CatMate Mac Preview"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="1.3.0-alpha.1"

[display]
window/size/viewport_width=224
window/size/viewport_height=224
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
